  "edges": [
    { "id": "e1", "from": "req_start", "to": "inv_scan", "label": "inspect inventory", "variant": "emphasis" },
    { "id": "e2", "from": "inv_scan", "to": "hw_check", "label": "check installed", "variant": "default" },
    { "id": "e3", "from": "hw_check", "to": "score_matrix", "label": "filter budget", "variant": "default" },
    { "id": "e4", "from": "score_matrix", "to": "pull_guard", "label": "missing weight?", "variant": "security" },
    { "id": "e5", "from": "pull_guard", "to": "runtime_bind", "label": "bind best model", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Zero-Download Engineering",
      "items": [
        "Inspects /api/tags and 'ollama list' before touching the network",
        "Reuses existing weights on the machine with zero download delay",
        "Prevents redundant multi-gigabyte downloads and eliminates wait time"
      ]
    },
    {
      "dot": "cyan",
      "title": "Family base scores (before size and keyword bonuses, capped at 100)",
      "items": [
        "1. Nanbeige (92 pts): Top agentic search and sequential multi-step tool calling",
        "2. DeepSeek Coder / R1 (90 pts): State-of-the-art coding and algorithmic synthesis",
        "3. Qwen 2.5 Coder (88 pts): Open-weights coding family with native tool calling",
        "4. Command R / Codestral / GLM-4 (82-86 pts): Dedicated tool calling & 32k context"
      ]
    },
    {
      "dot": "rose",
      "title": "PC Build Hardware Matching",
      "items": [
        "Workstation (VRAM 15 GB+, or 8 GB+ with 32 GB RAM): qwen2.5-coder:14b",
        "Mid-tier (VRAM 8 GB+ or RAM 16 GB+): qwen2.5-coder:7b",
        "Otherwise: llama3.2:3b"
      ]
    }
  ]
