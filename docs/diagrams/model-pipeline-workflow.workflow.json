  "nodes": [
    { "id": "req_start", "lane": "request", "col": 0, "type": "external", "label": "Model Request", "sublabel": "cli argument or default", "width": 140 },
    { "id": "inv_scan", "lane": "inventory", "col": 1, "type": "database", "label": "Ollama /api/tags", "sublabel": "inspect local weights", "tag": "zero re-download", "width": 140 },
    { "id": "hw_check", "lane": "request", "col": 2, "type": "security", "label": "Hardware Profile", "sublabel": "read VRAM and RAM", "tag": "OOM prevention", "width": 140 },
    { "id": "score_matrix", "lane": "evaluator", "col": 3, "type": "backend", "label": "Capability Ranker", "sublabel": "score, capped at 100", "tag": "agentic priority", "width": 140 },
    { "id": "pull_guard", "lane": "inventory", "col": 4, "type": "cloud", "label": "Defensive Pull", "sublabel": "pull only if uninstalled", "width": 140 },
    { "id": "runtime_bind", "lane": "execution", "col": 5, "type": "frontend", "label": "Antigravity Agent", "sublabel": "LocalOpenAI initialized", "tag": "tool-ready", "width": 140 }
