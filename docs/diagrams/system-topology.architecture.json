  "cards": [
    {
      "dot": "cyan",
      "title": "Air-Gapped & Decoupled",
      "items": [
        "LocalOpenAIConnectionStrategy redirects all LLM calls to http://localhost:11434/v1",
        "Zero Google Cloud API keys, auth tokens, or network egress required",
        "Compatible with Google Research AI Harness via ANTIGRAVITY_HARNESS_PATH"
      ]
    },
    {
      "dot": "emerald",
      "title": "Adaptive Hardware Offload",
      "items": [
        "A 14B model (about 9 GB of weights) fits in 16 GB of VRAM and runs fast",
        "When weights exceed VRAM, Ollama splits layers between GPU and CPU RAM (on one example 16 GB machine, Gemma 2 27B split about 79% GPU and 21% CPU)"
      ]
    },
    {
      "dot": "rose",
      "title": "Safe Workspace Isolation",
      "items": [
        "Antigravity Agent operates within isolated ./workspace directory",
        "Local filesystem modifications are strictly scoped to user workspace",
        "Memory search reads CONTEXT_MEMORY.md, which people edit by hand"
      ]
    }
