# Local LLM Server Endpoint (Ollama, LM Studio, vLLM, llama.cpp)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Default Model for Tool Calling & Agent Execution
# Recommended: qwen2.5:14b, llama3.1:8b, mistral-nemo
LOCAL_LLM_MODEL=qwen2.5:14b

# Optional: Path to custom Google Research AI Harness binary
# If omitted, google-antigravity uses its built-in bundled localharness binary
# ANTIGRAVITY_HARNESS_PATH=/usr/local/bin/localharness

